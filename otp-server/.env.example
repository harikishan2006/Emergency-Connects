# Copy this file to ".env" and fill in your real values.

# Port the OTP server listens on
PORT=3001

# Comma-separated list of allowed origins (your Lovable preview + localhost)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://id-preview--8fb227b0-eed1-496b-98f4-cc5c42a83612.lovable.app

# Gmail SMTP credentials
# 1. Enable 2-Step Verification on your Google account
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password (no spaces) below
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Display name shown in the From: header
FROM_NAME=EmergencyConnect

# OTP settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5